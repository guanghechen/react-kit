{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guanghechen/react-kit/tree/release-2.x.x"
  },
  "homepage": "https://github.com/guanghechen/react-kit/tree/release-2.x.x/#readme",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    ":publish": "pnpm clean && pnpm build:production && pnpm test:coverage && pnpm -r publish --no-git-checks",
    ":upgrade": "pnpm update -i && pnpm clean && pnpm format && pnpm build && pnpm test",
    "build": "cross-env NODE_ENV=production BUILD_SOURCEMAP=true pnpm -r run build",
    "build:production": "cross-env NODE_ENV=production BUILD_SOURCEMAP=false pnpm -r run build",
    "clean": "pnpm -r run clean && pnpm install",
    "format": "biome check --write .",
    "postinstall": "node script/install-hooks.mjs",
    "rebuild": "pnpm clean && pnpm build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:update": "vitest run --update --passWithNoTests",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "version": "pnpm install && node script/sync-doc-link.mjs && git stage -u pnpm-lock.yaml packages/**/package.json packages/**/*.md",
    ":publish:all": "pnpm -r exec npm version patch --no-git-tag-version && pnpm -r publish --no-git-checks",
    "lint": "biome check .",
    "test:dist": "node script/test-dist.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/cli": "^2.31.1",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "cross-env": "10.1.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "react": "19.3.0",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs,cts,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  }
}
