{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guanghechen/react-kit/tree/release-2.x.x"
  },
  "homepage": "https://github.com/guanghechen/react-kit/tree/release-2.x.x/#readme",
  "engines": {
    "node": ">= 18.0.0"
  },
  "type": "module",
  "scripts": {
    ":publish": "pnpm clean && pnpm build:production && pnpm test:coverage && pnpm -r publish --no-git-checks",
    ":upgrade": "pnpm update -i && pnpm clean && pnpm format && pnpm build && pnpm test",
    "build": "cross-env NODE_ENV=production ROLLUP_SHOULD_SOURCEMAP=true pnpm -r run build",
    "build:production": "cross-env NODE_ENV=production ROLLUP_SHOULD_SOURCEMAP=false pnpm -r run build",
    "clean": "pnpm -r run clean && pnpm install",
    "format": "pnpm format:lintfix && pnpm format:prettier",
    "format:prettier": "prettier . --write",
    "format:lintfix": "eslint . --fix",
    "postinstall": "node script/install-hooks.mjs",
    "rebuild": "pnpm clean && pnpm build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:update": "vitest run --update --passWithNoTests",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "version": "pnpm install && node script/sync-doc-link.mjs && git stage -u pnpm-lock.yaml packages/**/package.json packages/**/*.md",
    ":publish:all": "pnpm -r exec npm version patch --no-git-tag-version && pnpm -r publish --no-git-checks"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "10.0.1",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "cross-env": "10.1.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "rimraf": "6.1.3",
    "rollup": "4.63.1",
    "rollup-plugin-dts": "6.5.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,eslintrc}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.30.2"
}
